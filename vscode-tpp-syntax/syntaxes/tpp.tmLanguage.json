{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TPP",
  "scopeName": "source.tpp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tpp",
          "begin": "\\{",
          "end": "\\}"
        },
        {
          "name": "comment.line.double-slash.tpp",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.tpp",
          "match": "(?i)(?:(?<=\\W)|^)(se|então|entao|senão|senao|fim)(?=\\W|$)"
        },
        {
          "name": "keyword.control.repeat.tpp",
          "match": "(?i)(?:(?<=\\W)|^)(repita|até|ate)(?=\\W|$)"
        },
        {
          "name": "keyword.control.return.tpp",
          "match": "(?i)(?:(?<=\\W)|^)(retorna)(?=\\W|$)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tpp",
          "match": "(?i)(?:(?<=\\W)|^)(inteiro|flutuante)(?=\\W|$)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.io.tpp",
          "match": "(?i)(?:(?<=\\W)|^)(leia|escreva)(?=\\W|$)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.tpp"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tpp",
          "match": "(:=|=)"
        },
        {
          "name": "keyword.operator.comparison.tpp",
          "match": "(<>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.tpp",
          "match": "(\\+\\+|\\+|--|-|\\*|/)"
        },
        {
          "name": "keyword.operator.logical.tpp",
          "match": "(&&|\\|\\||!|(?i)(?:(?<=\\W)|^)(e|ou|não|nao)(?=\\W|$))"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scientific.tpp",
          "match": "\\b\\d+(\\.\\d+)?e(\\+|-)?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.tpp",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.tpp",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tpp",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}